# Copier en .env à côté de docker-compose.yml (ou saisir dans les variables d'environnement de la stack Portainer). Ne jamais committer.

# --- Obligatoire ---------------------------------------------------------------------------------------------
# Le compte de l'application MCZ Maestro+ (e-mail et mot de passe), celui avec lequel tu vois ton poêle dans l'app.
MCZ_USER=ton-email-maestro
MCZ_PASSWORD=ton-mot-de-passe-maestro
# Si le mot de passe contient un `$` : laisse MCZ_PASSWORD vide et donne-le en base64 ici (voir docs/installation.md)
MCZ_PASSWORD_B64=
# Jeton d'accès à l'API (pont Apple Maison, scripts, repli de connexion) : génère-le avec `openssl rand -hex 32`
BRIDGE_TOKEN=
# Connexion à la web app (identifiant et mot de passe au choix). Mot de passe avec un `$` : utilise WEB_PASSWORD_B64 (base64).
WEB_USER=
WEB_PASSWORD=
WEB_PASSWORD_B64=

# --- Facultatif ----------------------------------------------------------------------------------------------
# Fuseau horaire des plages (défaut Europe/Paris)
TIMEZONE=Europe/Paris
# Quantité de pellets qu'un réservoir plein contient vraiment, en kg (défaut 16)
PELLET_CAPACITY_KG=16
# Position pour la météo. Vide : la ville choisie dans l'app, sinon la position du poêle dans le cloud MCZ.
WEATHER_LAT=
WEATHER_LON=
# Adresse annoncée aux services de notification (https://ton-domaine ou mailto:toi@exemple.fr)
PUSH_SUBJECT=
# Port de la web app sur la machine (docker-compose.yml seulement, défaut 8000)
PORT=8000

# --- Avec Traefik (docker-compose.traefik.yml) ---------------------------------------------------------------
# Domaine servi par Traefik
BRIDGE_HOST=poele.example.com
# Nom du résolveur de certificats défini dans ton Traefik (certificatesResolvers.<nom>)
CERT_RESOLVER=letsencrypt
# Point(s) d'entrée Traefik et réseau Docker partagé avec Traefik
TRAEFIK_ENTRYPOINTS=websecure
TRAEFIK_NETWORK=proxy
